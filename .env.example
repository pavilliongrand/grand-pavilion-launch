# ============================================
# GRAND PAVILION TURF BOOKING - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git!

# Firebase Configuration (for OTP Authentication on client-side)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Calendar API (Used as booking database)
# Share your Google Calendar with the service account email
GOOGLE_CALENDAR_ID=your_calendar_email@gmail.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Admin Panel Password (server-side only, NOT exposed to browser)
ADMIN_PASSWORD=your_secure_admin_password

# Twilio Configuration (for OTP SMS delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=your_twilio_verify_service_sid
